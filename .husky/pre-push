#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/pre-push.d"

for hook in *; do
    [ -f "$hook" ] || continue
    if bash "./$hook"; then
        continue
    else
        RESULT=$?
        echo "pre-push.d/$hook returned non-zero: $RESULT, abort push"
        exit $RESULT
    fi
done

exit 0